<?xml version="1.0"?>
<ruleset name="Universal Custom Fonts">
	<description>WordPress Coding Standards with PSR-4 file names.</description>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.4"/>
	<rule ref="WordPress-Extra">
		<!-- PSR-4 autoloading needs ClassName.php files. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="universal-custom-fonts"/></property></properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array"><element value="ucf_"/><element value="UniversalCustomFonts"/></property></properties>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		
	</rule>
</ruleset>
